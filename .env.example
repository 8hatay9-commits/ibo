# Optional but recommended to avoid GitHub's low unauthenticated API rate limit.
GITHUB_TOKEN=

# Master key for owner/admin access. Buyers receive signed 30-day access tokens instead.
PREMIUM_API_KEY=replace-with-a-long-random-secret

# HMAC secret used to sign payment quotes and paid access tokens.
# Use a long random value in production.
ACCESS_TOKEN_SECRET=replace-with-a-different-long-random-secret

# Ethereum mainnet JSON-RPC endpoint. If blank, the app falls back to Cloudflare's public Ethereum RPC.
ETH_RPC_URL=
